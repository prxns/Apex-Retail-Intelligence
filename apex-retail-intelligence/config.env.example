# Databricks Volume containing the supplied internship files
APEX_RETAIL_SOURCE_ROOT=/Volumes/<catalog>/<schema>/<volume>
# Managed Delta storage for Raw/Landing/Bronze/Silver/Gold
APEX_RETAIL_DATA_ROOT=/Volumes/<catalog>/<schema>/<output_volume>
# Unity Catalog Gold registration target
APEX_RETAIL_CATALOG=<catalog>
APEX_RETAIL_GOLD_SCHEMA=GOLD_tables
